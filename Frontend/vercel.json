{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://<YOUR-RENDER-BACKEND-URL>/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://<YOUR-RENDER-BACKEND-URL>/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
